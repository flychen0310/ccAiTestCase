# DATABASE_URL: 不填默认使用 SQLite(data/app.db),生产可切换 PostgreSQL,例如:
# DATABASE_URL=postgresql+psycopg2://user:pwd@host:5432/dbname
DATABASE_URL=

# 允许跨域访问的前端地址,逗号分隔;开发环境可以用 * 放开
CORS_ORIGINS=*

# RAG_EMBEDDING_PROVIDER: tfidf(默认,本地计算无需 API key) / openai(语义检索更好,需要 OPENAI_API_KEY)
RAG_EMBEDDING_PROVIDER=tfidf

# LLM_PROVIDER: openai / anthropic / deepseek / mock
LLM_PROVIDER=openai

# 可选,不填则按 provider 使用默认模型
# openai 默认:   gpt-4o-mini
# anthropic 默认: claude-3-5-sonnet-20241022
# deepseek 默认:  deepseek-chat
LLM_MODEL=

# 按需填写对应供应商的 API Key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# 飞书文档链接导入:在飞书开放平台创建企业自建应用后填写,并给应用开通云文档读取权限。
# 不填则"从飞书链接导入"功能不可用(接口会返回明确提示),不影响手动粘贴需求。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书私有化/国际版可改此地址,默认公有云
FEISHU_BASE_URL=https://open.feishu.cn

# 需求配图(多模态):使用支持视觉的模型(openai/anthropic)时,配图会参与"需求理解"。
# deepseek/mock 不支持图片,会自动跳过图片、仅用文本,无需额外配置。以下均为可选覆盖项:
# UPLOAD_DIR=              # 图片存储目录,默认 data/uploads
# MAX_IMAGE_SIZE_MB=8      # 单张图片大小上限
# MAX_IMAGES_PER_REQUIREMENT=6  # 单个需求最多附带的图片数
